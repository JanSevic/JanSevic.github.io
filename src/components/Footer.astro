---
import { nav, site } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__cols">
    <p class="site-footer__name">{site.name}</p>
    <nav aria-label="Patička">
      {nav.map((item) => <a class="plain" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="site-footer__contact">
      <span class="site-footer__label">Kontakt</span>
      <a href={site.contact.x.url}>{site.contact.x.label}</a>
      <a href={site.contact.linkedin.url}>{site.contact.linkedin.label}</a>
      <a href={`mailto:${site.contact.email}`}>E-mail</a>
    </div>
  </div>
  <p class="wrap site-footer__copy">© {year} {site.name}</p>
</footer>

<style>
  .site-footer { background: var(--dark); color: var(--on-dark); padding: 72px var(--gutter) 36px; }
  .site-footer__cols { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 48px; }
  .site-footer__name { font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1; color: #fff; }
  nav, .site-footer__contact { display: flex; flex-direction: column; gap: 12px; font-size: 17px; }
  .plain { color: var(--on-dark); text-decoration: none; }
  .plain:hover { text-decoration: underline; }
  .site-footer__contact a { color: var(--accent-on-dark); }
  .site-footer__label { font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-muted); }
  .site-footer__copy { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--dark-line); font-size: 14px; color: var(--on-dark-muted); }
</style>
