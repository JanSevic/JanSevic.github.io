---
// Simulace počtu obyvatel Česka (kohortní model, výhled 50 let). Model a ovládání jsou v src/sim/.
import model from '../sim/model.js?raw';
import app from '../sim/app.js?raw';
import stav from '../sim/data/stav.json';

interface Props { nadpis?: boolean }
const { nadpis = true } = Astro.props;
const slidery = (p: string) => `<div class="sim-ctl" data-ctl="${p}"></div>`;
---
  <div class="sim" id="vb">
    <div class="sim-read">
      {nadpis && (
        <div class="sim-headblock">
          <span class="label">Simulace</span>
          <span class="bar bar--sm" aria-hidden="true"></span>
          <h2 class="h2-sub">Kolik nás bude</h2>
          <p class="muted">Simulace počítá s porody, úmrtími a migrací. Pro srovnání ukazuje i oficiální projekci ČSÚ.</p>
        </div>
      )}
      <blockquote class="sim-quote" id="b-head"></blockquote>
      <div class="sim-scen">
        <p class="sim-scen__t">Vyzkoušejte scénář</p>
        <div class="chips sim-presets" id="b-presets"></div>
      </div>
      <div class="sim-ctl2" set:html={slidery('b')} />
      <div>
        <h3 class="sim-h3">Za 10, 20 … 50 let</h3>
        <p class="muted sim-note">Svislá čárka v každém řádku je dnešní počet obyvatel.</p>
        <div class="sim-list" id="b-list"></div>
      </div>
      <div>
        <h3 class="sim-h3">Počet obyvatel</h3>
        <div class="sim-legend"><span><i class="k-line"></i>Zvolené hodnoty</span><span><i class="k-line k-base"></i>Výchozí hodnoty</span><span><i class="k-dash"></i>Projekce ČSÚ 2023, střední</span><span><i class="k-band"></i>ČSÚ nízká až vysoká</span></div>
        <div class="sim-fig sim-line" id="b-line"></div>
      </div>
      <div>
        <h3 class="sim-h3" id="b-pyr-t"></h3>
        <div class="sim-legend"><span><i class="k-box k-men"></i>Muži</span><span><i class="k-box k-women"></i>Ženy</span><span><i class="k-out k-out--ink"></i>Dnes (<span class="sim-start"></span>)</span></div>
        <div class="sim-play"><button class="chip" id="b-play" type="button" aria-pressed="false">Přehrát</button><input type="range" id="b-year" min="2025" max="2075" step="1" aria-label="Rok pyramidy"></div>
        <div class="sim-pyrhead"><span>Muži</span><span>Ženy</span></div>
        <div class="sim-fig sim-pyr" id="b-pyr"></div>
        <div class="sim-shares" id="b-shares"></div>
      </div>
      <details class="sim-method"><summary>Jak simulace počítá</summary><ul>
        <li>Počet obyvatel mění porody, úmrtí a migrace. Zvolené hodnoty platí od začátku simulace po celých 50 let. Výchozí věkové složení obyvatel je podle ČSÚ.</li>
        <li>Migrace je roční saldo: o kolik víc lidí se přistěhuje, než vystěhuje. Přistěhovalí jsou hlavně mladí dospělí (nejčastěji kolem 27 let), přibližně 12 % tvoří děti, 55 % muži. Ve Česku pak rodí a umírají jako ostatní.</li>
        <li>Přerušovaná čára je střední varianta projekce ČSÚ z roku 2023 (1,5 dítěte na ženu, saldo migrace 35 tisíc ročně), šedý pás sahá od nízké varianty (pokles plodnosti na 1,25 do roku 2050, migrace 25 tisíc) po vysokou (růst na 1,75, migrace 40 tisíc). Projekce vychází z dat do roku 2022, kdy se rodilo víc dětí: pro rok 2025 počítala s 90,6 tisíce narozených, skutečně se jich narodilo 77,6 tisíce. Další projekci ČSÚ vydá do konce roku 2028.</li>
        <li>Počet dětí na ženu je úhrnná plodnost: kolik dětí by žena měla, kdyby po celý život rodila jako ženy v daném roce. Kolem 2,1 se populace dlouhodobě udrží.</li>
        <li>První děti se rodí kolem zvoleného věku, druhé o zvolený rozestup později a každé další o 70 % rozestupu po předchozím. S výchozími hodnotami to dává průměrný věk matek 29,2 / 31,5 / 33,1 roku u prvního, druhého a třetího dítěte, jako uvádí ČSÚ. Rozestup je rozdíl průměrů, skutečný odstup sourozenců v jedné rodině bývá delší. Rozdělení na první, druhé a další děti odpovídá předpokladům ČSÚ.</li>
        <li>Změna se projevuje postupně: zvolené hodnoty platí plně pro dívky, které na začátku simulace ještě nerodily. Ženy nad 30 let pokračují jako dnes, mezi tím se přechází plynule.</li>
        <li>Naděje dožití je průměrný věk, kterého se dožije novorozenec. Roste podle projekce ČSÚ z roku 2023 (střední varianta), zvlášť pro muže a ženy. Riziko úmrtí roste s věkem zhruba exponenciálně (tzv. Gompertzův model).</li>
        <li>Výchozí hodnoty jsou podle ČSÚ za rok 2025: 1,28 dítěte na ženu, první dítě ve 29,2 letech, rozestup z průměrného věku matek u 1. a 2. dítěte a saldo migrace 42 tisíc. Naděje dožití roste podle projekce ČSÚ.</li>
      </ul></details>
    </div>
  </div>

<script is:inline set:html={`{const STAV = ${JSON.stringify(stav)};\n${model}\n${app}}`}></script>

<style is:global>
  .sim .chip { border-radius: 0; }

  /* ovládání */
  .sim-ctl { display: grid; gap: 26px; }
  .sim-sl label { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-weight: 600; font-size: 17px; line-height: 1.3; }
  .sim-sl label span { flex: 1 1 auto; min-width: 0; }
  .sim-sl output { font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1; color: var(--accent); white-space: nowrap; }
  .sim-sl small { display: block; font-size: 15px; color: var(--ink-muted); }
  .sim-sl input { -webkit-appearance: none; appearance: none; width: 100%; height: 40px; margin: 4px 0 0; background: transparent; cursor: pointer; --p: 50%; }
  .sim-sl input::-webkit-slider-runnable-track { height: 3px; background: linear-gradient(to right, var(--ink) var(--p), var(--line) var(--p)); }
  .sim-sl input::-moz-range-track { height: 3px; background: var(--line); }
  .sim-sl input::-moz-range-progress { height: 3px; background: var(--ink); }
  .sim-sl input::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; margin-top: -8.5px; background: var(--ink); border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--ink); }
  .sim-sl input::-moz-range-thumb { width: 14px; height: 14px; border-radius: 0; background: var(--ink); border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--ink); }
  .sim-sl input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sim-scen { display: flex; flex-direction: column; gap: 12px; }
  .sim-presets { flex-wrap: nowrap; overflow-x: auto; gap: 8px; padding: 2px; scrollbar-width: none; }
  .sim-presets .chip { padding: 8px 14px; font-size: 15px; white-space: nowrap; }
  .sim-scen__t { font-weight: 600; font-size: 17px; }
  .sim-reset { align-self: flex-start; justify-self: start; margin-top: -16px; background: none; border: 0; padding: 8px 0; color: var(--accent); font-family: var(--font-sans); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }

  /* grafy */
  .sim-h3 { font-size: 30px; line-height: 1.1; }
  .sim-legend { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 8px 0 12px; font-size: 15px; color: var(--ink-muted); }
  .sim-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .k-line { width: 20px; height: 3px; background: var(--accent); }
  .k-line.k-base { height: 2px; background: #9a9da2; }
  .k-box { width: 12px; height: 12px; background: #5f6369; }
  .k-men { background: #4f8fe0; } .k-women { background: #e5585b; }
  .k-kid { background: #a7aaae; } .k-work { background: #5f6369; } .k-old { background: var(--accent); }
  .k-band { width: 18px; height: 12px; background: color-mix(in srgb, var(--ink) 10%, transparent); border-top: 1px dotted var(--ink-muted); border-bottom: 1px dotted var(--ink-muted); }
  .k-dash { width: 22px; height: 0; border-top: 2px dashed var(--ink); }
  .k-out { width: 12px; height: 12px; border: 2px solid var(--accent); }
  .k-out--ink { border-color: var(--ink); }
  .sim-fig { position: relative; }
  .sim-fig > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .sim-line { height: clamp(260px, 30vw, 360px); }
  .sim-pyr { height: clamp(400px, 42vw, 520px); }
  .sim-ax { font: 500 14px var(--font-sans); fill: var(--ink-muted); }
  .sim-tip { position: absolute; z-index: 3; display: none; pointer-events: none; padding: 10px 14px; background: var(--surface-raised); border: 1px solid var(--ink); font-size: 15px; line-height: 1.45; white-space: nowrap; }
  .sim-tip b { font-family: var(--font-display); font-weight: 600; font-size: 24px; line-height: 1.1; }
  .sim-tip .lbl { font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .sim-pyrhead { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 4px; }
  .sim-years { margin-bottom: 18px; flex-wrap: nowrap; overflow-x: auto; padding: 2px; }
  .sim-years .chip, .chips .chip { flex: none; padding: 8px 16px; background: none; font-family: var(--font-sans); cursor: pointer; }
  .chip[aria-pressed='true'] { background: var(--ink); color: #fff; }

  /* čísla */
  .sim-keys { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; }
  .sim-keys .keynum { padding: 22px 24px; gap: 8px; }
  .sim-keys .keynum__value { font-size: clamp(44px, 4.4vw, 64px); white-space: nowrap; }
  .sim-keys .keynum p { font-size: 16px; line-height: 1.4; }
  .sim-dec { display: flex; overflow-x: auto; margin-top: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .sim-dec div { flex: 1 0 74px; padding: 12px 8px; text-align: right; border-left: 1px solid var(--line); }
  .sim-dec div:first-child { border-left: 0; }
  .sim-dec span { display: block; font-size: 13px; color: var(--ink-muted); white-space: nowrap; }
  .sim-dec b { font-family: var(--font-display); font-weight: 600; font-size: 26px; line-height: 1.1; }
  .sim-dec .cur { background: var(--surface-sunken); box-shadow: inset 0 3px 0 var(--accent); }

  /* A */
  .sim-side { gap: 18px !important; }
  .sim-side .sim-ctl { margin-top: 18px; padding-top: 26px; border-top: 2px solid var(--line); }
  .sim-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px; }
  .sim-c > div, .sim-read > * { min-width: 0; }
  @media (min-width: 1000px) { .sim-side { position: sticky; top: 76px; align-self: flex-start; } }

  /* B */
  .sim { padding: 0; }
  .sim-read { max-width: var(--reading); margin: 0 auto; padding: 0 var(--gutter); display: grid; gap: 48px; box-sizing: content-box; }
  .sim-headblock { display: flex; flex-direction: column; gap: 16px; }
  .sim-quote { position: sticky; top: 0; z-index: 5; margin: 0; padding: 14px 0 14px 24px; background: var(--surface); border-left: 5px solid var(--mark); font-family: var(--font-display); font-weight: 600; font-size: clamp(28px, 3.2vw, 38px); line-height: 1.2; text-wrap: balance; }
  .sim-quote em { font-style: normal; color: var(--accent); white-space: nowrap; }
  .sim-ctl2 .sim-ctl { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 26px 40px; }
  .sim-note { font-size: 15px; margin: 6px 0 14px; }
  .sim-list { border-top: 1px solid var(--line); }
  .sim-list div { display: grid; grid-template-columns: 96px minmax(0, 1fr) 100px; gap: 14px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .sim-list span:first-child { font-size: 16px; color: var(--ink-muted); }
  .sim-list .bar2 { position: relative; height: 10px; background: var(--surface-sunken); }
  .sim-list .bar2 i { position: absolute; inset: 0 auto 0 0; background: #5f6369; }
  .sim-list .bar2 u { position: absolute; top: -5px; bottom: -5px; width: 2px; background: var(--accent); }
  .sim-list b { text-align: right; font-family: var(--font-display); font-weight: 600; font-size: 26px; line-height: 1; white-space: nowrap; }
  .sim-play { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .sim-play input { flex: 1 1 auto; accent-color: var(--ink); height: 40px; }
  .sim-shares { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 24px; }
  .sim-shares div { padding-top: 12px; border-top: 2px solid var(--ink); font-size: 15px; color: var(--ink-muted); }
  .sim-shares b { display: block; font-family: var(--font-display); font-weight: 600; font-size: 44px; line-height: 1; color: var(--ink); }

  .sim-method { border-top: 1px solid var(--line); }
  .sim-method summary { cursor: pointer; min-height: 56px; display: flex; align-items: center; font-weight: 600; }
  .sim-method ul { max-width: 72ch; padding-left: 1.2em; color: var(--ink-muted); }
  .sim-method li + li { margin-top: 8px; }

  @media (max-width: 600px) {
    .sim-keys { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .sim-keys .keynum { padding: 14px 12px; border-top-width: 4px; }
    .sim-keys .keynum__value { font-size: 30px; }
    .sim-keys .keynum p { font-size: 13px; }
    .sim-line { height: 250px; }
    .sim-pyr { height: 420px; }
    .sim-list div { grid-template-columns: 74px minmax(0, 1fr) 76px; gap: 10px; }
    .sim-list b { font-size: 22px; }
    .sim-shares b { font-size: 34px; }
    .sim-table { font-size: 15px; }
    
    .sim-sl output { font-size: 30px; }
  }
</style>
