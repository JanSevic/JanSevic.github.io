---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate } from '../../site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('prispevky', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const temata = (await getCollection('temata')).sort((a, b) => a.data.order - b.data.order);
const first = page.currentPage === 1;
const [featured, ...rest] = first ? page.data : [undefined, ...page.data];
const featuredTema = featured ? await getEntry(featured.data.tema) : undefined;
---
<Base title={first ? 'Příspěvky' : `Příspěvky – strana ${page.currentPage}`} active="Příspěvky">
  <PageHead title="Příspěvky" lead="[místo pro text: o čem tu píšu, 1 věta]" />
  <section class="section">
    <div class="wrap">
      <nav class="chips filter reveal" aria-label="Příspěvky podle tématu">
        <a class="chip" href="/prispevky/" aria-current="page">Vše</a>
        {temata.map((t) => <a class="chip" href={`/temata/${t.id}/#prispevky`}>{t.data.title}</a>)}
      </nav>

      {page.data.length === 0 && <p class="lead">Zatím tu nejsou žádné příspěvky.</p>}

      {featured && (
        <a href={`/prispevky/${featured.id}/`} class="featured post-card reveal">
          {featured.data.obrazek
            ? <Image src={featured.data.obrazek} alt="" widths={[640, 1040]} sizes="(min-width: 1100px) 640px, 100vw" class="featured__img" />
            : <div class="ph featured__img" data-label="Obrázek příspěvku (nepovinný)"></div>}
          <div class="featured__text">
            <div class="meta">
              <span class="label">Nejnovější</span>
              <span class="tema">{featuredTema?.data.title}</span>
              <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
            </div>
            <h2 class="h2-sub">{featured.data.title}</h2>
            <p class="muted">{featured.data.perex}</p>
            <span class="more">Číst příspěvek →</span>
          </div>
        </a>
      )}

      {rest.length > 0 && <div class="grid-3">{rest.map((p) => p && <PostCard post={p} />)}</div>}

      {page.lastPage > 1 && (
        <nav class="pager" aria-label="Stránkování">
          {page.url.prev ? <a href={page.url.prev}>← Novější</a> : <span></span>}
          <span class="muted">Strana {page.currentPage} z {page.lastPage}</span>
          {page.url.next ? <a href={page.url.next}>Starší příspěvky →</a> : <span></span>}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .filter { margin-bottom: 56px; }
  .featured { flex-direction: row !important; flex-wrap: wrap; align-items: center; gap: 32px clamp(32px, 5vw, 72px) !important; margin-bottom: 72px; }
  .featured :global(.featured__img) { flex: 1.3 1 520px; aspect-ratio: 16 / 10; width: 100%; object-fit: cover; }
  .featured__text { flex: 1 1 380px; display: flex; flex-direction: column; gap: 16px; }
  .featured__text p { font-size: 19px; }
  .featured:hover .more { transform: translateX(5px); }
  .pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 17px; font-weight: 600; }
</style>
